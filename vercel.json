{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/problemas",
      "destination": "/preview/h0/index.html"
    },
    {
      "source": "/criticidad",
      "destination": "/preview/h0/index.html"
    },
    {
      "source": "/abordabilidad",
      "destination": "/preview/h0/index.html"
    },
    {
      "source": "/oportunidades",
      "destination": "/preview/h0/index.html"
    },
    {
      "source": "/metodos",
      "destination": "/preview/h0/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/preview/h0/index.html",
      "permanent": false
    }
  ]
}
